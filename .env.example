# ---------------------------------------------------------------------------
# Luma Studio — AI Receptionist
# Copy this file to .env.local and fill in the values you need.
# ---------------------------------------------------------------------------

# Public URL of this app (used for OAuth redirects and absolute links).
APP_URL=http://localhost:3000

# Store time zone. Defaults to UTC-4 to match the demo environment.
# Use a regional IANA zone such as America/New_York for production.
BUSINESS_TIMEZONE=Etc/GMT+4

# AI provider: deepseek | groq | openai-compatible
# Leave the selected provider's key empty to use the built-in fallback bot.
AI_PROVIDER=deepseek
AI_TIMEOUT_MS=30000
# auto | live | fallback
AI_MODE=auto

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Groq (OpenAI-compatible endpoint). Test the model before relying on it.
# AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Generic OpenAI-compatible endpoint. Include the version path if required,
# for example https://your-provider.example/v1 (do not include /chat/completions).
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Google Calendar OAuth. Leave blank until you have a Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_ID=primary

# Admin login. Set a strong password before exposing the app.
ADMIN_PASSWORD=change-me
# Random 32+ byte value used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Seed the demo business, services, staff and FAQs on first run.
SEED_DEMO=true

{
  "name": "luma-ai-receptionist",
  "version": "1.0.0",
  "private": true,
  "description": "English AI receptionist with real-time availability, appointment booking, and Google Calendar sync.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "db:reset": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "chrono-node": "2.10.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "googleapis": "189.0.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}

